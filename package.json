{
  "name": "healverse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "start": "pnpm --dir apps/web start",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "prisma:generate": "pnpm --dir packages/database prisma:generate"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.2",
    "better-auth": "^1.7.2"
  }
}